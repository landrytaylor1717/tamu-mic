# Free key at https://finnhub.io/register — no credit card required.
# Copy this file to .env.local and paste your key in. Without it, the
# ticker just shows each stock's `fallback` value from tickerConfig.js.
FINNHUB_API_KEY=

# Signs the /members login session cookie. Required for the members area
# to work at all — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret and out of git; rotating it logs everyone out.
SESSION_SECRET=
